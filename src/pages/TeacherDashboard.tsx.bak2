import { useCallback, useEffect, useMemo, useState } from 'react';
import { QRScanner } from '../components/QRScanner';
import { Alert, PageHeader, Spinner } from '../components/ui';
import { useAuth } from '../context/useAuth';
import { ApiError, markAttendance, registerDevice, subscribeMyDay } from '../lib/api';
import { getOrCreateDeviceIdentity } from '../lib/device';
import { formatClock, formatIstLong, nowIstDateKey } from '../lib/time';
import type { AttendanceType, DailyAttendance } from '../lib/types';

type Notice = { tone: 'success' | 'error' | 'warning' | 'info'; text: string } | null;

export function TeacherDashboard() {
  const { profile, device, deviceLoading } = useAuth();
  const [todayKey] = useState(() => nowIstDateKey());
  const [record, setRecord] = useState<DailyAttendance | null>(null);
  const [scannerOpen, setScannerOpen] = useState(false);
  const [qrToken, setQrToken] = useState<string | null>(null);
  const [busy, setBusy] = useState<string | null>(null);
  const [notice, setNotice] = useState<Notice>(null);
  const [dataError, setDataError] = useState<string | null>(null);

  const recordId = profile ? `${profile.teacherId}_${todayKey}` : '';

  useEffect(() => {
    if (!profile) return undefined;
    const unsubscribeDay = subscribeMyDay(
      recordId,
      (value) => setRecord(value),
      (error) => setDataError(error.message)
    );
    return () => {
      unsubscribeDay();
    };
  }, [profile, recordId]);

  const identity = useMemo(() => getOrCreateDeviceIdentity(), []);

  const deviceApproved =
    device !== null &&
    device.status === 'approved' &&
    device.deviceId === identity.deviceId;

  const handleRegisterDevice = useCallback(async () => {
    if (!profile) return;
    setBusy('register');
    setNotice(null);
    try {
      const result = await registerDevice(identity.deviceId, identity.deviceSecret, identity.label);
      if (result.status === 'approved') {
        setNotice({ tone: 'success', text: result.message });
      } else {
        setNotice({
          tone: 'warning',
          text: result.message
        });
      }
    } catch (e) {
      setNotice({
        tone: 'error',
        text: e instanceof ApiError ? e.message : 'Could not register this device.'
      });
    } finally {
      setBusy(null);
    }
  }, [profile, identity]);

  const handleScan = useCallback((text: string) => {
    const token = text.trim();
    if (!token) return;
    setQrToken(token);
    setScannerOpen(false);
    setNotice({ tone: 'info', text: 'QR code captured. Choose Arrival or Departure.' });
  }, []);

  const submit = useCallback(
    async (type: AttendanceType) => {
      if (!qrToken) {
        setNotice({ tone: 'error', text: 'Scan the college QR code first.' });
        return;
      }
      setBusy(type);
      setNotice(null);
      try {
        const result = await markAttendance({
          qrToken,
          type,
          deviceId: identity.deviceId,
          deviceSecret: identity.deviceSecret
        });
        setNotice({
          tone: 'success',
          text: `${type === 'arrival' ? 'Arrival' : 'Departure'} recorded at ${result.timeLabel} (server time, IST) on ${result.date}.`
        });
        setQrToken(null);
      } catch (e) {
        setNotice({
          tone: 'error',
          text: e instanceof ApiError ? e.message : 'Attendance could not be recorded.'
        });
      } finally {
        setBusy(null);
      }
    },
    [qrToken, identity]
  );

  if (!profile) return <Spinner label="Loading your dashboard" />;

  const todayStatus = record
    ? {
        arrival: record.arrivalTime ?? formatClock(record.arrivalMs),
        departure: record.departureTime ?? formatClock(record.departureMs),
        late: Boolean(record.isLate),
        early: Boolean(record.earlyDeparture)
      }
    : null;

  // Teacher interface does not show attendance history per requirements

  return (
    <div className="space-y-4">
      <PageHeader
        title={`Welcome, ${profile.name.split(' ')[0]}`}
        subtitle={formatIstLong(Date.now())}
      />

      <div className="grid gap-3 sm:grid-cols-2">
        <div className="card">
          <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">Teacher ID</p>
          <p className="mt-1 text-2xl font-bold text-brand-900">{profile.teacherId}</p>
          <p className="muted mt-1">{profile.name}</p>
        </div>
        <div className="card">
          <p className="text-xs font-semibold uppercase tracking-wide text-slate-500">Today's status</p>
          {todayStatus ? (
            <div className="mt-1 space-y-1 text-sm">
              <p>
                Arrival:{' '}
                <span className="font-semibold text-slate-800">{todayStatus.arrival}</span>
                {todayStatus.late && (
                  <span className="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-semibold text-amber-800">
                    Late
                  </span>
                )}
              </p>
              <p>
                Departure:{' '}
                <span className="font-semibold text-slate-800">{todayStatus.departure}</span>
                {todayStatus.early && (
                  <span className="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-semibold text-amber-800">
                    Early
                  </span>
                )}
              </p>
            </div>
          ) : (
            <p className="mt-1 text-2xl font-bold text-slate-400">Not marked yet</p>
          )}
        </div>
      </div>

      {dataError && <Alert tone="warning">{dataError}</Alert>}

      <Alert tone="info" title="Working day">
        Only one Arrival and one Departure are accepted per working day, and Departure is only
        accepted after Arrival. Times are recorded by the college server in Indian Standard Time.
      </Alert>

      {deviceLoading ? (
        <Spinner label="Checking device" />
      ) : !device ? (
        <div className="card space-y-3">
          <div>
            <h2 className="font-semibold text-brand-900">Register this phone</h2>
            <p className="muted">
              This is the first time you are signing in on this installation. Register it so the
              administrator can approve it.
            </p>
          </div>
          <button
            type="button"
            className="btn-primary w-full sm:w-auto"
            onClick={handleRegisterDevice}
            disabled={busy === 'register'}
          >
            {busy === 'register' ? 'Registeringâ€¦' : `Register ${identity.label}`}
          </button>
        </div>
      ) : !deviceApproved ? (
        <Alert tone="warning" title="Device approval pending">
          {device.pendingDeviceId && device.pendingDeviceId !== identity.deviceId
            ? 'A different installation is awaiting administrator approval. Your previously approved phone keeps working until the change is approved.'
            : 'This installation is waiting for administrator approval. Attendance marking is disabled until it is approved.'}
        </Alert>
      ) : null}

      <div className="card space-y-4 no-print">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 className="font-semibold text-brand-900">Mark attendance</h2>
            <p className="muted">{formatIstLong(Date.now())} Â· Indian Standard Time</p>
          </div>
          <button
            type="button"
            className="btn-secondary"
            onClick={() => setScannerOpen((open) => !open)}
            disabled={!deviceApproved}
          >
            {scannerOpen ? 'Hide scanner' : 'Scan college QR'}
          </button>
        </div>

        <QRScanner active={scannerOpen} onScan={handleScan} onClose={() => setScannerOpen(false)} />

        {qrToken && (
          <Alert tone="success" title="QR code captured">
            The college QR token is ready. Choose an action below.
          </Alert>
        )}

        <div className="grid gap-3 sm:grid-cols-2">
          <button
            type="button"
            className="btn-primary min-h-[64px] w-full text-base"
            onClick={() => submit('arrival')}
            disabled={!deviceApproved || !qrToken || busy !== null}
          >
            {busy === 'arrival' ? 'Recording arrivalâ€¦' : 'Mark Arrival'}
          </button>
          <button
            type="button"
            className="btn-primary min-h-[64px] w-full text-base"
            onClick={() => submit('departure')}
            disabled={!deviceApproved || !qrToken || busy !== null}
          >
            {busy === 'departure' ? 'Recording departureâ€¦' : 'Mark Departure'}
          </button>
        </div>

        {!deviceApproved && (
          <p className="muted text-center">Attendance buttons unlock after device approval.</p>
        )}
        {deviceApproved && !qrToken && (
          <p className="muted text-center">Scan the college QR code to unlock the buttons.</p>
        )}

        {notice && <Alert tone={notice.tone}>{notice.text}</Alert>}

      <div className="card">
        <p className="muted">
      <div className="card">
      <div className="card">
      <div className="card">
        <p className="muted">Attendance history is not available to teachers. Contact the administrator for any correction or records.</p>
  );
}

